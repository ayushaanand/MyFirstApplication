<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainUI"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/modern_background"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/loginNameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="56dp"
        android:text="Name : "
        android:textSize="20sp"
        android:textColor="#333333"
        android:fontFamily="monospace"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/passKey"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="Key :"
        android:textSize="20sp"
        android:textColor="#333333"
        android:fontFamily="monospace"
        app:layout_constraintEnd_toEndOf="@+id/loginNameLabel"
        app:layout_constraintTop_toBottomOf="@+id/loginNameLabel" />

    <TextView
        android:id="@+id/compResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="52dp"
        android:text="Result Here"
        android:textSize="18sp"
        android:textColor="#2C3E50"
        android:fontFamily="sans-serif-medium"
        android:textStyle="normal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/passKey" />

    <EditText
        android:id="@+id/loginName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:ems="10"
        android:inputType="text"
        android:fontFamily="monospace"
        app:layout_constraintBaseline_toBaselineOf="@+id/loginNameLabel"
        app:layout_constraintStart_toEndOf="@+id/loginNameLabel" />

    <EditText
        android:id="@+id/keyInput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="textPassword"
        android:fontFamily="monospace"
        app:layout_constraintBaseline_toBaselineOf="@+id/passKey"
        app:layout_constraintStart_toStartOf="@+id/loginName" />

    <ImageView
        android:id="@+id/greeneryTexture"
        android:layout_width="313dp"
        android:layout_height="275dp"
        android:alpha="0.8"
        android:scaleType="fitEnd"
        android:src="@drawable/greenery_texture"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>